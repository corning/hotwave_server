# ============================================================
# HotWave Server 环境变量模板
# 复制为 .env 后填写：cp .env.example .env
# ============================================================

# ===== 基础 =====
# JWT 签名密钥。生产环境必须设置 ≥32 字节随机串：
#   openssl rand -hex 32
# 留空时开发模式会使用不安全的默认值；生产模式下签发/校验会失败（登录返回 500）。
SECRET_KEY=

# 监听地址与端口。默认只绑回环地址，由本机反向代理（nginx / caddy /
# Tailscale serve 等）对外终结 TLS。切勿直接绑 0.0.0.0 暴露到公网。
# 注意不要用 HOSTNAME：Docker 会自动注入该变量，容易覆盖监听地址。
BIND_HOST=127.0.0.1
PORT=8000

# SQLite 数据库文件（相对仓库根目录）。首次运行会自动建目录与表。
DATABASE_PATH=database/hotwave.db

# 时区：交易时段、心跳日期均按北京时间计算。
TZ=Asia/Shanghai

# ===== hotwave 反向长连接 =====
# hotwave 用 binding 凭证主动连入本服务的 WS 端口。
# 默认仅监听回环；容器/跨机部署时改为 0.0.0.0 并配置防火墙。
HOTWAVE_WS_PORT=18791
# HOTWAVE_WS_HOST=127.0.0.1

# ===== Chat 引擎 =====
# kernel：server 直接调用本机 hotwave 运行时 HTTP（单主机单 Agent，推荐）
# legacy：经 hotwave 反向 WS 连接下发 chat.send（多用户 / 多绑定场景）
# 不设置时等价于 legacy。
CHAT_ENGINE=kernel
AGENT_RUNTIME_URL=http://127.0.0.1:8791
# 与 hotwave 的 AGENT_RUNTIME_TOKEN 保持一致；hotwave 未设置则留空。
AGENT_RUNTIME_TOKEN=

# ===== 交易 =====
# 模拟盘初始资金（元），用于 /api/account/summary 重放交易。
PAPER_INITIAL_CASH=1000000

# ===== hotwave 进程托管（可选）=====
# 开启后 APP 可通过 /api/agent/supervisor 查询/重启 hotwave 系统服务。
# 默认关闭：该接口会执行本机 launchctl / systemctl 命令。
HOTWAVE_SUPERVISOR_ENABLED=false
# launchd label（macOS）或 systemd unit 名（Linux）。
HOTWAVE_SUPERVISOR_LABEL=com.hotwave.runtime
